# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk
.idea
# Added by cargo

/target

# Snapshots insta writes beside a failing one; never committed
*.snap.new
*.pending-snap

# The wasm-pack output. `ts-lib/src/pkg` is generated by ts-lib's build-wasm
# script and `pkg/` by a bare `wasm-pack build`; neither is committed, so that
# no build of the library can go stale in the repository.
/pkg/
ts-lib/src/pkg/

# The whole SingleStepTests/m68000 suite, which scripts/fetch-m68000-tests.sh
# fetches for the ignored conformance tests; only a subset is committed
/tests/m68000/fetched/
